import streamlit as st
import pandas as pd
import duckdb
import base64
import faiss
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
import boto3
import json

# AWS Bedrock Runtime client
bedrock_client = boto3.client("bedrock-runtime", region_name="us-east-1")

# Claude Sonnet Model ID (latest available - update if needed)
bedrock_model_id = "anthropic.claude-3-sonnet-20240229-v1:0"

# Load Excel Data
file_path = "Banking_Dataset.xlsx"
xls = pd.ExcelFile(file_path)

dfs = {}
for sheet in xls.sheet_names:
    df = xls.parse(sheet)
    df.columns = [col.strip().replace(" ", "_") for col in df.columns]
    dfs[sheet] = df

# Register in DuckDB
conn = duckdb.connect(database=":memory:")
for name, df in dfs.items():
    conn.register(name, df)

# Generate column descriptions
column_descriptions = []
for table_name, df in dfs.items():
    for col in df.columns:
        column_descriptions.append(f"{table_name}.{col}")

# TF-IDF Vectorization
vectorizer = TfidfVectorizer()
tfidf_matrix = vectorizer.fit_transform(column_descriptions).toarray().astype('float32')

# FAISS Index
dimension = tfidf_matrix.shape[1]
faiss_index = faiss.IndexFlatL2(dimension)
faiss_index.add(tfidf_matrix)

# Cache & history
sql_cache = {}
question_history = []
sql_history = []
question_embeddings = []
sql_embeddings = []

# Get DB Schema
def get_database_schema():
    schema = {}
    for table_name in dfs:
        result = conn.execute(f"DESCRIBE {table_name}").fetchdf()
        schema[table_name] = ", ".join(result['column_name'].tolist())
    return schema

# Validate SQL
def is_valid_sql(query):
    try:
        conn.execute(f"EXPLAIN {query}")
        return True
    except:
        return False

# Execute SQL
def run_sql_query(query):
    try:
        result_df = conn.execute(query).fetchdf()
        if result_df.empty:
            return "No matching records found.", None
        return result_df.to_html(index=False), result_df
    except Exception as e:
        return f"Error: {e}", None

# 🔥 Claude Sonnet SQL Generator
def generate_sql_from_bedrock(natural_query):

    if natural_query in sql_cache:
        st.info("Using cached SQL query...")
        return sql_cache[natural_query]

    schema = get_database_schema()
    schema_text = "\n".join([f"{t}: {c}" for t, c in schema.items()])

    prompt = f"""
You are an expert SQL assistant.

Convert the following natural language question into a valid DuckDB SQL query.

Rules:
- Only generate SQL
- No explanation
- No comments
- Use correct table/column names

Schema:
{schema_text}

Question:
{natural_query}

SQL:
"""

    try:
        response = bedrock_client.invoke_model(
            modelId=bedrock_model_id,
            contentType="application/json",
            accept="application/json",
            body=json.dumps({
                "anthropic_version": "bedrock-2023-05-31",
                "max_tokens": 500,
                "messages": [
                    {
                        "role": "user",
                        "content": prompt
                    }
                ]
            })
        )

        response_body = json.loads(response['body'].read())
        sql_query = response_body['content'][0]['text'].strip()

        # Safety filter
        if any(word in sql_query.upper() for word in ["DROP", "DELETE", "ALTER", "--"]):
            return None

        if not is_valid_sql(sql_query):
            return None

        # Store history
        question_history.append(natural_query)
        sql_history.append(sql_query)

        q_emb = vectorizer.transform([natural_query]).toarray().astype('float32')
        s_emb = vectorizer.transform([sql_query]).toarray().astype('float32')

        question_embeddings.append(q_emb[0])
        sql_embeddings.append(s_emb[0])

        faiss_index.add(q_emb)
        faiss_index.add(s_emb)

        sql_cache[natural_query] = sql_query

        return sql_query

    except Exception as e:
        st.error(f"Claude Error: {e}")
        return None

# FAISS similarity search
def search_history_faiss(text, top_k=3):

    if not question_embeddings:
        return [], []

    query_vec = vectorizer.transform([text]).toarray().astype('float32')
    _, indices = faiss_index.search(query_vec, top_k)

    similar_q = []
    similar_sql = []

    for i in indices[0]:
        if i < len(question_history):
            similar_q.append(question_history[i])
            similar_sql.append(sql_history[i])

    return similar_q, similar_sql

# Streamlit UI
st.title("Claude Sonnet SQL Generator (AWS Bedrock)")

user_query = st.text_input("Ask your question:")

if user_query:
    with st.spinner("Generating SQL using Claude Sonnet..."):

        sql_query = generate_sql_from_bedrock(user_query)

        if sql_query:
            st.subheader("Generated SQL:")
            st.code(sql_query)

            result_html, _ = run_sql_query(sql_query)

            st.subheader("Results:")
            st.write(result_html, unsafe_allow_html=True)
        else:
            st.error("Failed to generate valid SQL")

    similar_q, similar_sql = search_history_faiss(user_query)

    if similar_q:
        st.subheader("Similar Questions:")
        for i in range(len(similar_q)):
            st.write(f"{i+1}. {similar_q[i]}")
            st.code(similar_sql[i])

# Sidebar cache
st.sidebar.title("Query Cache")
for q, s in sql_cache.items():
    st.sidebar.write(f"Q: {q}")
    st.sidebar.code(s)
