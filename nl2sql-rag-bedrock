# ---------------------- AWS BEDROCK SETUP ---------------------- #
bedrock_client = boto3.client("bedrock-runtime", region_name="us-east-1")
model_id = "amazon.titan-txt-embeddings-v2"

# ---------------------- DATA LOADING ---------------------- #
def load_s3_excel(bucket_name, prefix, aws_region="us-east-1"):
    """Load all Excel files from S3 and return a dictionary of DataFrames"""
    s3_client = boto3.client("s3", region_name=aws_region)
    objects = s3_client.list_objects_v2(Bucket=bucket_name, Prefix=prefix).get("Contents", [])
    dfs = {}
    for obj in objects:
        if obj['Key'].endswith((".xlsx", ".xls")):
            excel_obj = s3_client.get_object(Bucket=bucket_name, Key=obj['Key'])
            xls = pd.ExcelFile(io.BytesIO(excel_obj['Body'].read()))
            for sheet in xls.sheet_names:
                df = xls.parse(sheet)
                df.columns = [col.strip().replace(" ", "_") for col in df.columns]
                table_name = f"{obj['Key'].split('/')[-1].replace('.xlsx','')}_{sheet}"
                dfs[table_name] = df
    return dfs

def load_db_tables(db_type, host, port, db_name, user, password, tables=None):
    """Load tables from a traditional database"""
    if db_type == "postgresql":
        conn_str = f"postgresql://{user}:{password}@{host}:{port}/{db_name}"
    elif db_type == "mysql":
        conn_str = f"mysql+pymysql://{user}:{password}@{host}:{port}/{db_name}"
    elif db_type == "mssql":
        conn_str = f"mssql+pyodbc://{user}:{password}@{host}:{port}/{db_name}?driver=ODBC+Driver+17+for+SQL+Server"
    else:
        raise ValueError("Unsupported DB type")
    
    engine = create_engine(conn_str)
    if tables is None:
        tables = engine.table_names()
    
    dfs = {}
    for table in tables:
        df = pd.read_sql_table(table, engine)
        df.columns = [col.strip().replace(" ", "_") for col in df.columns]
        dfs[table] = df
    return dfs

# ---------------------- DUCKDB REGISTRATION ---------------------- #
def register_in_duckdb(dfs):
    """Register multiple DataFrames in DuckDB"""
    conn = duckdb.connect(database=":memory:")
    for name, df in dfs.items():
        conn.register(name, df)
    return conn

# ---------------------- SCHEMA CHUNKING ---------------------- #
def chunk_schema(dfs, chunk_size=5):
    """Split each table's columns into schema chunks for RAG retrieval"""
    chunks = []
    for table_name, df in dfs.items():
        cols = df.columns.tolist()
        for i in range(0, len(cols), chunk_size):
            chunk_cols = cols[i:i+chunk_size]
            chunks.append(f"{table_name}: {', '.join(chunk_cols)}")
    return chunks

# ---------------------- TF-IDF + FAISS ---------------------- #
def build_faiss_index(schema_chunks):
    vectorizer = TfidfVectorizer()
    embeddings = vectorizer.fit_transform(schema_chunks).toarray().astype('float32')
    index = faiss.IndexFlatL2(embeddings.shape[1])
    index.add(embeddings)
    return vectorizer, index, embeddings

def retrieve_relevant_schema(query, vectorizer, faiss_index, schema_chunks, top_k=5):
    query_vec = vectorizer.transform([query]).toarray().astype('float32')
    _, indices = faiss_index.search(query_vec, top_k)
    return "\n".join([schema_chunks[i] for i in indices[0]])

# ---------------------- SQL UTILITY ---------------------- #
def is_valid_sql(query, conn):
    try:
        conn.execute(f"EXPLAIN {query}")
        return True
    except:
        return False

def run_sql_query(query, conn):
    try:
        result_df = conn.execute(query).fetchdf()
        return result_df.to_html(index=False), result_df
    except Exception as e:
        return f"Error: {e}", None

# ---------------------- HISTORY CACHE ---------------------- #
sql_cache = {}
question_history, sql_history = [], []
question_embeddings, sql_embeddings = [], []

# ---------------------- GENERATE SQL WITH RAG, REFLECTION & GUARDRAILS ---------------------- #
def generate_sql_bedrock(natural_query, conn, vectorizer, faiss_index, schema_chunks):
    if natural_query in sql_cache:
        st.toast("Using cached SQL query...")
        return sql_cache[natural_query]

    # RAG: retrieve relevant schema chunks
    relevant_schema = retrieve_relevant_schema(natural_query, vectorizer, faiss_index, schema_chunks, top_k=5)

    forbidden_keywords = ["DROP", "DELETE", "ALTER", "--", ";--"]

    prompt = f"""
You are a SQL expert assistant. Convert the user's natural language query into a valid DuckDB SQL query.
Use only the following relevant schema chunks:
{relevant_schema}

Question: {natural_query}

Requirements:
1. Avoid destructive SQL: {', '.join(forbidden_keywords)}
2. Validate table and column existence.
3. If uncertain about column/table mapping, reflect assumptions clearly.
4. Return only syntactically correct SQL that runs on DuckDB.
5. Do not hallucinate or invent tables/columns.

SQL Query:
"""

    try:
        body = json.dumps({"inputText": prompt})
        response = bedrock_client.invoke_model(
            body=body,
            modelId=model_id,
            accept="application/json",
            contentType="application/json"
        )
        result = json.loads(response['body'].read().decode("utf-8"))
        sql_query = result.get("results", [{}])[0].get("outputText", "").strip()

        # Guardrails
        if any(word in sql_query.upper() for word in forbidden_keywords):
            st.warning("Generated SQL contains forbidden keywords. Skipping execution.")
            return None
        if not is_valid_sql(sql_query, conn):
            st.warning("Generated SQL is invalid. Skipping execution.")
            return None

        # Update cache and history
        sql_cache[natural_query] = sql_query
        question_history.append(natural_query)
        sql_history.append(sql_query)

        q_emb = vectorizer.transform([natural_query]).toarray().astype('float32')
        s_emb = vectorizer.transform([sql_query]).toarray().astype('float32')
        question_embeddings.append(q_emb[0])
        sql_embeddings.append(s_emb[0])
        faiss_index.add(q_emb)
        faiss_index.add(s_emb)

        return sql_query
    except Exception as e:
        st.error(f"Bedrock API error: {e}")
        return None

def search_history_faiss(text, vectorizer, faiss_index, top_k=3):
    if not question_embeddings:
        return [], []
    query_vec = vectorizer.transform([text]).toarray().astype('float32')
    _, indices = faiss_index.search(query_vec, top_k)
    return [question_history[i] for i in indices[0]], [sql_history[i] for i in indices[0]]

