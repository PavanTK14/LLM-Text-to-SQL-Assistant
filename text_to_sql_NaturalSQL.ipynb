
import pandas as pd
from transformers import AutoTokenizer, AutoModelForCausalLM
import torch
import duckdb
import ipywidgets as widgets
from IPython.display import display, HTML

# Load NaturalSQL model
model_name = "NaturalSQL-6.7B"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name, torch_dtype=torch.float32)
device = torch.device("cpu")
model.to(device)

# Load Excel and create DuckDB tables
file_path = "/mnt/data/Banking_Dataset.xlsx"
try:
    xls = pd.ExcelFile(file_path)
    dfs = {}
    for sheet in xls.sheet_names:
        df = xls.parse(sheet)
        df.columns = [col.strip().replace(" ", "_") for col in df.columns]
        dfs[sheet] = df
except Exception as e:
    raise Exception(f"Error loading Excel file: {e}")

# Connect to DuckDB and register DataFrames
conn = duckdb.connect(database=':memory:')
for table_name, df in dfs.items():
    conn.register(table_name, df)

# Extract schema info
def get_database_schema():
    schema = {}
    for table_name in dfs:
        try:
            result = conn.execute(f"DESCRIBE {table_name}").fetchdf()
            schema[table_name] = ", ".join(result['column_name'].tolist())
        except Exception as e:
            schema[table_name] = f"Error: {e}"
    return schema

# Execute SQL and return HTML
def run_sql_query(query: str):
    try:
        print(f"Executing SQL:\n{query}\n")
        result_df = conn.execute(query).fetchdf()
        if result_df.empty:
            return "<b>No matching records found.</b>"
        return result_df.to_html(index=False)
    except Exception as e:
        return f"<b>Error executing query:</b> {e}"

# Generate SQL from natural language
def generate_sql(natural_query):
    schema = get_database_schema()
    schema_text = "\n".join([f"{table}: {cols}" for table, cols in schema.items()])

    prompt = f"""
You are an AI SQL assistant. Convert the question below into a valid DuckDB SQL query.
Support RIGHT JOIN, FULL OUTER JOIN, LEFT JOIN, INNER JOIN, CURDATE(), DATEDIFF(), GETDATE().
Avoid DROP, DELETE, ALTER, or stored procedures. Assume all enums are stored as text.

Database Schema:
{schema_text}

Question: {natural_query}

SQL Query:
"""
    inputs = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=1024).to(device)
    outputs = model.generate(**inputs, max_length=512, do_sample=True, temperature=0.5, top_k=20)
    decoded = tokenizer.decode(outputs[0], skip_special_tokens=True).strip()

    if "SQL Query:" in decoded:
        sql_query = decoded.split("SQL Query:")[-1].strip()
    else:
        sql_query = decoded.strip()

    forbidden = ["DROP", "DELETE", "--", "ALTER"]
    if not sql_query or any(word in sql_query.upper() for word in forbidden):
        print("Unsafe SQL generated.")
        return None

    print("Generated SQL:\n", sql_query)
    return sql_query

# UI Components
input_box = widgets.Text(
    placeholder="Enter your natural language query...",
    layout=widgets.Layout(width="100%")
)
submit_button = widgets.Button(description="Generate SQL & Execute", button_style='success')
sql_output_box = widgets.Textarea(layout=widgets.Layout(height="80px", width="100%"), disabled=True)
output_box = widgets.HTML()
schema_output = widgets.HTML()
schema_toggle = widgets.Checkbox(value=False, description="Show Database Schema")

# Toggle for showing schema
def on_schema_toggle(change):
    if change['new']:
        schema = get_database_schema()
        schema_html = "<br>".join([f"<b>{table}</b>: {cols}" for table, cols in schema.items()])
        schema_output.value = f"<h4>Database Schema</h4><div style='font-family:monospace'>{schema_html}</div>"
    else:
        schema_output.value = ""

schema_toggle.observe(on_schema_toggle, names='value')

# Button click handler
def on_button_click(b):
    input_text = input_box.value.strip()
    if not input_text:
        output_box.value = "Please enter a query."
        return

    sql_query = generate_sql(input_text)
    sql_output_box.value = sql_query or ""

    if not sql_query:
        output_box.value = "<b>Error:</b> Unsafe or invalid SQL."
        return

    result = run_sql_query(sql_query)
    output_box.value = f"<b>Result:</b><br>{result}"

submit_button.on_click(on_button_click)

# Display UI
ui = widgets.VBox([
    input_box,
    submit_button,
    sql_output_box,
    output_box,
    schema_toggle,
    schema_output
])
display(ui)

